<UserControl x:Class="LaraStack.User.Views.PhpIniPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBg}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header + toolbar -->
    <Border Grid.Row="0" Background="White"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
            Padding="26,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="🐘" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="php.ini Editor" Foreground="{StaticResource BrushNavy}"
                       FontFamily="Segoe UI Semibold" FontSize="20" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="IniPathTxt" Text="Loading…"
                     Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="11"/>
        </StackPanel>

        <!-- Action buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnReload" Content="↺  Reload" Style="{StaticResource BtnGhost}"
                  Padding="16,9" Margin="0,0,8,0" Click="Reload_Click"/>
          <Button x:Name="BtnSave" Content="💾  Save &amp; Apply" Style="{StaticResource BtnPrimary}"
                  Padding="16,9" Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1" Margin="26,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ── Left: Quick-setting cards (scrollable) ── -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
          <StackPanel>
            <TextBlock Text="QUICK SETTINGS" Foreground="#3A4C80"
                       FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <!-- ── PERFORMANCE ── -->
            <TextBlock Text="PERFORMANCE" Foreground="#6B7280"
                       FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" Margin="2,4,0,6"/>

            <!-- memory_limit -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="memory_limit" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Max RAM per script" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <TextBox x:Name="TxtMemory" Style="{StaticResource TxtBox}" FontFamily="Consolas"
                         FontSize="12" Padding="8,6" TextChanged="QuickSetting_Changed"/>
              </StackPanel>
            </Border>

            <!-- max_execution_time -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="max_execution_time" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Script timeout (seconds)" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <TextBox x:Name="TxtMaxExec" Style="{StaticResource TxtBox}" FontFamily="Consolas"
                         FontSize="12" Padding="8,6" TextChanged="QuickSetting_Changed"/>
              </StackPanel>
            </Border>

            <!-- max_input_time -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="max_input_time" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Max time to parse input (sec)" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <TextBox x:Name="TxtMaxInputTime" Style="{StaticResource TxtBox}" FontFamily="Consolas"
                         FontSize="12" Padding="8,6" TextChanged="QuickSetting_Changed"/>
              </StackPanel>
            </Border>

            <!-- ── UPLOADS ── -->
            <TextBlock Text="UPLOADS" Foreground="#6B7280"
                       FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" Margin="2,8,0,6"/>

            <!-- upload_max_filesize -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="upload_max_filesize" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Max file upload size" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <TextBox x:Name="TxtUpload" Style="{StaticResource TxtBox}" FontFamily="Consolas"
                         FontSize="12" Padding="8,6" TextChanged="QuickSetting_Changed"/>
              </StackPanel>
            </Border>

            <!-- post_max_size -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="post_max_size" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Max POST body size" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <TextBox x:Name="TxtPost" Style="{StaticResource TxtBox}" FontFamily="Consolas"
                         FontSize="12" Padding="8,6" TextChanged="QuickSetting_Changed"/>
              </StackPanel>
            </Border>

            <!-- max_file_uploads -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="max_file_uploads" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Max number of files per request" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <TextBox x:Name="TxtMaxFileUploads" Style="{StaticResource TxtBox}" FontFamily="Consolas"
                         FontSize="12" Padding="8,6" TextChanged="QuickSetting_Changed"/>
              </StackPanel>
            </Border>

            <!-- ── ERRORS ── -->
            <TextBlock Text="ERRORS" Foreground="#6B7280"
                       FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" Margin="2,8,0,6"/>

            <!-- display_errors -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="display_errors" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Show errors in browser" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <ComboBox x:Name="CboDisplayErrors" FontFamily="Consolas" FontSize="12"
                          BorderBrush="{StaticResource BrushBorder}" Padding="8,6"
                          SelectionChanged="QuickCombo_Changed">
                  <ComboBoxItem Content="On"/>
                  <ComboBoxItem Content="Off"/>
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- error_reporting -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="error_reporting" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="PHP error reporting level" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <TextBox x:Name="TxtErrorReporting" Style="{StaticResource TxtBox}" FontFamily="Consolas"
                         FontSize="12" Padding="8,6" TextChanged="QuickSetting_Changed"/>
              </StackPanel>
            </Border>

            <!-- log_errors -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="log_errors" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Write errors to log file" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <ComboBox x:Name="CboLogErrors" FontFamily="Consolas" FontSize="12"
                          BorderBrush="{StaticResource BrushBorder}" Padding="8,6"
                          SelectionChanged="QuickCombo_Changed">
                  <ComboBoxItem Content="On"/>
                  <ComboBoxItem Content="Off"/>
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- ── TIMEZONE &amp; LOCALE ── -->
            <TextBlock Text="TIMEZONE" Foreground="#6B7280"
                       FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" Margin="2,8,0,6"/>

            <!-- date.timezone -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="date.timezone" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="e.g. Asia/Karachi, UTC" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <TextBox x:Name="TxtTimezone" Style="{StaticResource TxtBox}" FontFamily="Consolas"
                         FontSize="12" Padding="8,6" TextChanged="QuickSetting_Changed"/>
              </StackPanel>
            </Border>

            <!-- ── SESSION ── -->
            <TextBlock Text="SESSION" Foreground="#6B7280"
                       FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" Margin="2,8,0,6"/>

            <!-- session.gc_maxlifetime -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="session.gc_maxlifetime" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Session lifetime (seconds)" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <TextBox x:Name="TxtSessionLife" Style="{StaticResource TxtBox}" FontFamily="Consolas"
                         FontSize="12" Padding="8,6" TextChanged="QuickSetting_Changed"/>
              </StackPanel>
            </Border>

            <!-- session.cookie_httponly -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="session.cookie_httponly" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Protect session cookie (XSS)" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <ComboBox x:Name="CboCookieHttpOnly" FontFamily="Consolas" FontSize="12"
                          BorderBrush="{StaticResource BrushBorder}" Padding="8,6"
                          SelectionChanged="QuickCombo_Changed">
                  <ComboBoxItem Content="1"/>
                  <ComboBoxItem Content="0"/>
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- ── OPCACHE ── -->
            <TextBlock Text="OPCACHE" Foreground="#6B7280"
                       FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" Margin="2,8,0,6"/>

            <!-- opcache.enable -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="opcache.enable" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Enable PHP opcode cache" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <ComboBox x:Name="CboOpcache" FontFamily="Consolas" FontSize="12"
                          BorderBrush="{StaticResource BrushBorder}" Padding="8,6"
                          SelectionChanged="QuickCombo_Changed">
                  <ComboBoxItem Content="1"/>
                  <ComboBoxItem Content="0"/>
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- opcache.memory_consumption -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="opcache.memory_consumption" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Opcache RAM in MB" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <TextBox x:Name="TxtOpcacheMem" Style="{StaticResource TxtBox}" FontFamily="Consolas"
                         FontSize="12" Padding="8,6" TextChanged="QuickSetting_Changed"/>
              </StackPanel>
            </Border>

            <!-- ── EXTENSIONS ── -->
            <TextBlock Text="EXTENSIONS" Foreground="#6B7280"
                       FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" Margin="2,8,0,6"/>

            <!-- short_open_tag -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="short_open_tag" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Allow &lt;? tags (not recommended)" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <ComboBox x:Name="CboShortTag" FontFamily="Consolas" FontSize="12"
                          BorderBrush="{StaticResource BrushBorder}" Padding="8,6"
                          SelectionChanged="QuickCombo_Changed">
                  <ComboBoxItem Content="Off"/>
                  <ComboBoxItem Content="On"/>
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- default_charset -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="default_charset" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="12"/>
                <TextBlock Text="Default character encoding" Foreground="{StaticResource BrushTextSub}"
                           FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,8"/>
                <TextBox x:Name="TxtDefaultCharset" Style="{StaticResource TxtBox}" FontFamily="Consolas"
                         FontSize="12" Padding="8,6" TextChanged="QuickSetting_Changed"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- Unsaved indicator pinned to bottom -->
        <Border Grid.Row="1" x:Name="UnsavedBadge" CornerRadius="8" Padding="10,7"
                Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1"
                Margin="0,8,6,0" Visibility="Collapsed">
          <TextBlock Text="⚠  Unsaved changes" Foreground="#B45309"
                     FontFamily="Segoe UI Semibold" FontSize="11" TextAlignment="Center"/>
        </Border>
      </Grid>

      <!-- ── Right: Raw editor ── -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Editor toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="RAW EDITOR" Foreground="#3A4C80"
                     FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock Text="Find: " Foreground="{StaticResource BrushTextSub}"
                       FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtSearch" Style="{StaticResource TxtBox}" Width="160"
                     FontSize="12" Padding="8,5" TextChanged="Search_Changed"/>
          </StackPanel>
        </Grid>

        <!-- php.ini textarea -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <TextBox x:Name="RawEditor"
                     FontFamily="Consolas" FontSize="13"
                     Background="White" Foreground="#1A1A2E"
                     BorderThickness="0"
                     AcceptsReturn="True" AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Padding="16"
                     TextChanged="RawEditor_Changed"
                     SpellCheck.IsEnabled="False"/>

            <!-- PHP not found overlay -->
            <Border x:Name="NotFoundOverlay" Background="#F8FAFF" CornerRadius="14" Visibility="Collapsed">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🐘" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="php.ini not found" Foreground="{StaticResource BrushNavy}"
                           FontFamily="Segoe UI Semibold" FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock Text="Install PHP first via the Installer tab, then return here."
                           Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,6,0,16"/>
                <Button Content="Go to Installer →" Style="{StaticResource BtnPrimary}"
                        Padding="20,10" HorizontalAlignment="Center" Click="GoInstall_Click"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
