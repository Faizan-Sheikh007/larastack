<UserControl x:Class="LaraStack.User.Views.InstallerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBg}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,20">
      <TextBlock Text="Installer" Foreground="{StaticResource BrushNavy}" FontFamily="Segoe UI Semibold" FontSize="20" Margin="0,0,0,4"/>
      <TextBlock Text="Downloads PHP, MySQL, and phpMyAdmin automatically from official sources"
                 Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="12" Margin="0,0,0,22"/>

      <!-- Install path -->
      <TextBlock Text="INSTALL DIRECTORY" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="PathBox" Style="{StaticResource TxtBox}" Grid.Column="0"/>
        <Button Grid.Column="2" Content="Browse…" Style="{StaticResource BtnGhost}" Padding="16,9" Click="Browse_Click"/>
      </Grid>

      <!-- PHP -->
      <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
              <TextBlock Text="🐘  PHP 8.3" Foreground="{StaticResource BrushNavy}" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,12,0"/>
              <Border x:Name="PhpStatus" CornerRadius="6" Padding="8,2" Background="#EEF1F8">
                <TextBlock x:Name="PhpStatusTxt" Text="Not Installed" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10"/>
              </Border>
            </StackPanel>
            <TextBlock Text="NTS Windows x64 · mysqli, pdo_mysql, mbstring, curl, openssl  (~30 MB)" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="11"/>
            <TextBlock Text="Source: windows.php.net (official)" Foreground="#9CA3AF" FontFamily="Segoe UI" FontSize="10" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" x:Name="BtnPhp" Content="⬇  Install PHP" Style="{StaticResource BtnPrimary}" Padding="16,10" VerticalAlignment="Center" Click="InstallPhp_Click"/>
        </Grid>
      </Border>

      <!-- MySQL -->
      <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
              <TextBlock Text="🐬  MySQL 8.0" Foreground="{StaticResource BrushNavy}" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,12,0"/>
              <Border x:Name="MySqlStatus" CornerRadius="6" Padding="8,2" Background="#EEF1F8">
                <TextBlock x:Name="MySqlStatusTxt" Text="Not Installed" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10"/>
              </Border>
            </StackPanel>
            <TextBlock Text="Community Edition, no-installer, Windows x64  (~350 MB)" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="11"/>
            <TextBlock Text="Source: dev.mysql.com (official)" Foreground="#9CA3AF" FontFamily="Segoe UI" FontSize="10" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" x:Name="BtnMySql" Content="⬇  Install MySQL" Style="{StaticResource BtnPurple}" Padding="16,10" VerticalAlignment="Center" Click="InstallMySql_Click"/>
        </Grid>
      </Border>

      <!-- phpMyAdmin -->
      <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,22">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
              <TextBlock Text="🗄  phpMyAdmin 5.2" Foreground="{StaticResource BrushNavy}" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,12,0"/>
              <Border x:Name="PmaStatus" CornerRadius="6" Padding="8,2" Background="#EEF1F8">
                <TextBlock x:Name="PmaStatusTxt" Text="Not Installed" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10"/>
              </Border>
            </StackPanel>
            <TextBlock Text="Web-based MySQL admin into www/phpmyadmin  (~15 MB)" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="11"/>
            <TextBlock Text="Source: files.phpmyadmin.net (official)" Foreground="#9CA3AF" FontFamily="Segoe UI" FontSize="10" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" x:Name="BtnPma" Content="⬇  Install PMA" Style="{StaticResource BtnGhost}" Padding="16,10" VerticalAlignment="Center" Click="InstallPma_Click"/>
        </Grid>
      </Border>

      <!-- Error -->
      <Border x:Name="ErrorBox" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="⚠  Error" Foreground="#DC2626" FontFamily="Segoe UI Semibold" FontSize="13" Margin="0,0,0,6"/>
          <TextBlock x:Name="ErrorTxt" Foreground="#7F1D1D" FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Progress -->
      <Border x:Name="ProgressBox" Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,18" Visibility="Collapsed">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="ProgressLbl" Text="Downloading…" Foreground="{StaticResource BrushNavy}" FontFamily="Segoe UI Semibold" FontSize="13"/>
            <TextBlock x:Name="ProgressPctTxt" Text=" 0%" Foreground="{StaticResource BrushBlue}" FontFamily="Segoe UI Semibold" FontSize="13"/>
          </StackPanel>
          <ProgressBar x:Name="ProgressBarCtrl" Height="10" Minimum="0" Maximum="100" Background="#EEF1F8" BorderThickness="0" Margin="0,0,0,8">
            <ProgressBar.Foreground>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#2255DD" Offset="0"/><GradientStop Color="#3AB8D8" Offset="1"/>
              </LinearGradientBrush>
            </ProgressBar.Foreground>
          </ProgressBar>
          <TextBlock x:Name="ProgressDetail" Text="" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="11"/>
        </StackPanel>
      </Border>

      <!-- Install log -->
      <Border x:Name="LogBox" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,22" Visibility="Visible">
        <StackPanel>
          <TextBlock Text="INSTALL LOG" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ListBox x:Name="InstallLog" Background="Transparent" BorderThickness="0" MaxHeight="130" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,2"/><Setter Property="Focusable" Value="False"/></Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding TimestampStr}" Foreground="#CBD5E1" Width="58"/>
                  <Border Background="#EEF1F8" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                    <TextBlock Text="{Binding LevelTag}" Foreground="{Binding LevelBrush}" FontSize="9"/>
                  </Border>
                  <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushTextSub}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Button x:Name="BtnAll" Content="⬇   INSTALL ALL COMPONENTS AUTOMATICALLY"
              Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Padding="26,13" FontSize="14"
              Click="InstallAll_Click"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
