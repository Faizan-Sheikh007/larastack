<UserControl x:Class="LaraStack.User.Views.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBg}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,20">
      <TextBlock Text="Monitor" Foreground="{StaticResource BrushNavy}" FontFamily="Segoe UI Semibold" FontSize="20" Margin="0,0,0,4"/>
      <TextBlock Text="Real-time system resource monitoring" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="12" Margin="0,0,0,22"/>

      <!-- Stat cards row -->
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
          <StackPanel>
            <TextBlock Text="CPU" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="CpuVal" Text="0%" Foreground="{StaticResource BrushGreen}" FontFamily="Segoe UI Black" FontSize="30"/>
            <ProgressBar x:Name="CpuBar" Height="6" Minimum="0" Maximum="100" Value="0" Background="#EEF1F8" BorderThickness="0" Margin="0,10,0,0">
              <ProgressBar.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00CB71" Offset="0"/><GradientStop Color="#3AB8D8" Offset="1"/></LinearGradientBrush></ProgressBar.Foreground>
            </ProgressBar>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
          <StackPanel>
            <TextBlock Text="RAM" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="RamVal" Text="0%" Foreground="{StaticResource BrushPurple}" FontFamily="Segoe UI Black" FontSize="30"/>
            <ProgressBar x:Name="RamBar" Height="6" Minimum="0" Maximum="100" Value="0" Background="#EEF1F8" BorderThickness="0" Margin="0,10,0,0">
              <ProgressBar.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#A020F0" Offset="0"/><GradientStop Color="#C850C0" Offset="1"/></LinearGradientBrush></ProgressBar.Foreground>
            </ProgressBar>
            <TextBlock x:Name="RamDetail" Text="" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,18">
          <StackPanel>
            <TextBlock Text="DISK" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="DiskVal" Text="0%" Foreground="{StaticResource BrushPink}" FontFamily="Segoe UI Black" FontSize="30"/>
            <ProgressBar x:Name="DiskBar" Height="6" Minimum="0" Maximum="100" Value="0" Background="#EEF1F8" BorderThickness="0" Margin="0,10,0,0">
              <ProgressBar.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF4F7B" Offset="0"/><GradientStop Color="#FF6B90" Offset="1"/></LinearGradientBrush></ProgressBar.Foreground>
            </ProgressBar>
            <TextBlock x:Name="DiskDetail" Text="" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="6" Style="{StaticResource Card}" Padding="20,18">
          <StackPanel>
            <TextBlock Text="SERVICES" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="SvcPhp"   Text="PHP    —" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="13" Margin="0,3"/>
            <TextBlock x:Name="SvcMySql" Text="MySQL  —" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="13" Margin="0,3"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- CPU Chart -->
      <TextBlock Text="CPU USAGE — LAST 60 SECONDS" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
        <StackPanel>
          <Canvas x:Name="CpuChart" Height="100" Background="Transparent" SizeChanged="Chart_SizeChanged"/>
          <Grid Margin="0,8,0,0">
            <TextBlock Text="0%" Foreground="#D1D5DB" FontSize="9" HorizontalAlignment="Left"/>
            <TextBlock Text="50%" Foreground="#D1D5DB" FontSize="9" HorizontalAlignment="Center"/>
            <TextBlock Text="100%" Foreground="#D1D5DB" FontSize="9" HorizontalAlignment="Right"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- RAM Chart -->
      <TextBlock Text="RAM USAGE — LAST 60 SECONDS" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
        <StackPanel>
          <Canvas x:Name="RamChart" Height="100" Background="Transparent" SizeChanged="Chart_SizeChanged"/>
          <Grid Margin="0,8,0,0">
            <TextBlock Text="0%" Foreground="#D1D5DB" FontSize="9" HorizontalAlignment="Left"/>
            <TextBlock Text="50%" Foreground="#D1D5DB" FontSize="9" HorizontalAlignment="Center"/>
            <TextBlock Text="100%" Foreground="#D1D5DB" FontSize="9" HorizontalAlignment="Right"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- CPU+RAM combined -->
      <TextBlock Text="CPU vs RAM — OVERLAY" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
        <StackPanel>
          <Canvas x:Name="OverlayChart" Height="100" Background="Transparent" SizeChanged="Chart_SizeChanged"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Border Width="10" Height="10" CornerRadius="2" Background="#00CB71" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="CPU  " Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Border Width="10" Height="10" CornerRadius="2" Background="#A020F0" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="RAM" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
