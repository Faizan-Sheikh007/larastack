<Window x:Class="LaraStack.User.Views.AnnouncementPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaraStack" Height="Auto" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Height">

  <Window.Resources>
    <DropShadowEffect x:Key="Shadow" BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
  </Window.Resources>

  <Border CornerRadius="14" Effect="{StaticResource Shadow}" Margin="12">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D1B5E" Offset="0"/>
        <GradientStop Color="#1A2F8A" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header bar -->
      <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="18,14,14,14">
        <Border.Background>
          <SolidColorBrush Color="#161F6E"/>
        </Border.Background>
        <Grid>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconLabel" Text="ℹ" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="TypeLabel" Text="Announcement" Foreground="White"
                       FontFamily="Segoe UI Semibold" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4">
            <TextBlock Text="✕" Foreground="#9B99C0" FontSize="12"/>
          </Button>
        </Grid>
      </Border>

      <!-- Body -->
      <Border Grid.Row="1" Padding="18,16">
        <StackPanel>
          <TextBlock x:Name="MessageLabel" Foreground="White"
                     FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap"
                     LineHeight="20" Margin="0,0,0,10"/>
          <StackPanel x:Name="VersionPanel" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
            <TextBlock Text="Version: " Foreground="#9B99C0" FontFamily="Segoe UI" FontSize="11"/>
            <TextBlock x:Name="VersionLabel" Foreground="#00CB71" FontFamily="Segoe UI Semibold" FontSize="11"/>
          </StackPanel>
          <TextBlock x:Name="FromLabel" Foreground="#9B99C0" FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,0"/>
        </StackPanel>
      </Border>

      <!-- Action buttons -->
      <Border Grid.Row="2" Padding="18,0,18,16">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" x:Name="ButtonPanel">
        <Button x:Name="DownloadBtn" Content="⬇ Download Update" Click="Download_Click"
                Visibility="Collapsed" Margin="0,0,10,0" Padding="14,8"
                FontFamily="Segoe UI" FontSize="12" Cursor="Hand"
                Background="#00CB71" Foreground="White" BorderThickness="0">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" CornerRadius="8"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Button Content="Dismiss" Click="Close_Click" Padding="14,8"
                FontFamily="Segoe UI" FontSize="12" Cursor="Hand"
                Background="#1E2D7D" Foreground="#9B99C0" BorderThickness="0">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" CornerRadius="8"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>
      </Border>

    </Grid>
  </Border>
</Window>
