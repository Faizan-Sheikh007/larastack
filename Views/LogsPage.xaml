<UserControl x:Class="LaraStack.User.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBg}">
  <Grid Margin="26,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="Logs" Foreground="{StaticResource BrushNavy}" FontFamily="Segoe UI Semibold" FontSize="20" Margin="0,0,0,4"/>
      <TextBlock Text="Live server and system event log" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="12"/>
    </StackPanel>

    <!-- Filters -->
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="148"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Search box with icon -->
      <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="1" CornerRadius="20" Height="38">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource BrushTextSub}" IsHitTestVisible="False"/>
          <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource TxtBox}"
                   BorderThickness="0" Background="Transparent" Padding="0,0,10,0"
                   VerticalAlignment="Center" FontSize="12"
                   TextChanged="Filter_Changed"/>
        </Grid>
      </Border>

      <!-- Level filter ComboBox -->
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="1" CornerRadius="20" Height="38">
        <ComboBox x:Name="LevelFilter" SelectedIndex="0" SelectionChanged="Filter_Changed"
                  FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"
                  BorderThickness="0" Background="Transparent" Padding="12,0,10,0"
                  Foreground="{StaticResource BrushNavy}">
          <ComboBox.Resources>
            <Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style>
          </ComboBox.Resources>
          <ComboBoxItem Content="All Levels"/>
          <ComboBoxItem Content="Info"/>
          <ComboBoxItem Content="Success"/>
          <ComboBoxItem Content="Warning"/>
          <ComboBoxItem Content="Error"/>
        </ComboBox>
      </Border>

      <!-- Auto-scroll toggle -->
      <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="1" CornerRadius="20" Padding="14,0" Height="38">
        <CheckBox x:Name="AutoScroll" IsChecked="True" VerticalAlignment="Center" Cursor="Hand">
          <CheckBox.Template>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal">
                <!-- Custom pill toggle -->
                <Border x:Name="pill" Width="34" Height="18" CornerRadius="20" Background="#D8E2F5" Margin="0,0,8,0" VerticalAlignment="Center">
                  <Border x:Name="knob" Width="12" Height="12" CornerRadius="6" Background="White"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0"/>
                </Border>
                <TextBlock Text="Auto-scroll" FontFamily="Segoe UI" FontSize="12"
                           Foreground="{StaticResource BrushNavy}" VerticalAlignment="Center"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="pill"  Property="Background" Value="{StaticResource BrushGreen}"/>
                  <Setter TargetName="knob"  Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="knob"  Property="Margin" Value="0,0,3,0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="pill" Property="Opacity" Value="0.85"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </CheckBox.Template>
        </CheckBox>
      </Border>

      <!-- Clear button -->
      <Button Grid.Column="6" Style="{StaticResource BtnDanger}" Padding="16,0" Height="38"
              Click="Clear_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="🗑" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="Clear" FontFamily="Segoe UI Semibold" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- Log list -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
      <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
               FontFamily="Consolas" FontSize="12" Padding="12"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F5F7FF"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding TimestampStr}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
              <Border Grid.Column="1" CornerRadius="4" Padding="5,2" Margin="0,0,10,0">
                <Border.Background><SolidColorBrush Color="#EEEEFF" Opacity="0.4"/></Border.Background>
                <TextBlock Text="{Binding LevelTag}" Foreground="{Binding LevelBrush}" FontSize="9" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource BrushText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Count -->
    <TextBlock Grid.Row="3" x:Name="CountTxt" Text="0 entries"
               Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="11"
               Margin="0,10,0,0" HorizontalAlignment="Right"/>
  </Grid>
</UserControl>
