<UserControl x:Class="LaraStack.User.Views.DatabasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBg}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,20">
      <TextBlock Text="Database" Foreground="{StaticResource BrushNavy}" FontFamily="Segoe UI Semibold" FontSize="20" Margin="0,0,0,4"/>
      <TextBlock Text="MySQL database access and management" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="12" Margin="0,0,0,22"/>

      <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,16">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="50" Height="50" CornerRadius="13" Margin="0,0,16,0" Background="#F5F0FF">
              <TextBlock Text="🗄" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="phpMyAdmin" Foreground="{StaticResource BrushNavy}" FontFamily="Segoe UI Semibold" FontSize="17" Margin="0,0,0,3"/>
              <TextBlock Text="Web-based MySQL administration" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="12"/>
            </StackPanel>
          </StackPanel>
          <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,18"/>
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="URL" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock x:Name="PmaUrl" Text="http://localhost:8080/phpmyadmin" Foreground="{StaticResource BrushBlue}" FontFamily="Segoe UI" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="USERNAME" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock Text="root" Foreground="{StaticResource BrushNavy}" FontFamily="Segoe UI Semibold" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="PASSWORD" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock Text="(none)" Foreground="{StaticResource BrushTextSub}" FontFamily="Segoe UI" FontSize="13"/>
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal">
            <Button Content="🌐  Open phpMyAdmin" Style="{StaticResource BtnPurple}" Padding="18,11" Margin="0,0,10,0" Click="OpenPma_Click"/>
            <Button x:Name="BtnStartMySql" Content="▶  Start MySQL" Style="{StaticResource BtnGreen}" Padding="18,11" Click="StartMySql_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- MySQL status -->
      <Border x:Name="MySqlWarning" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12" Padding="18,14" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="⚠  MySQL is not running. " Foreground="#DC2626" FontFamily="Segoe UI" FontSize="12"/>
          <Button Content="Start it now →" Background="Transparent" BorderThickness="0" Foreground="#2255DD"
                  FontFamily="Segoe UI Semibold" FontSize="12" Cursor="Hand" Padding="0" Click="StartMySql_Click"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
