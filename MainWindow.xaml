<Window x:Class="LaraStack.User.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="LaraStack" Height="840" Width="1300"
        MinHeight="660" MinWidth="1060"
        Background="{StaticResource BrushBg}"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background"                 Value="Transparent"/>
      <Setter Property="Foreground"                 Value="#8A96C0"/>
      <Setter Property="BorderThickness"            Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontFamily"                 Value="Segoe UI"/>
      <Setter Property="FontSize"                   Value="13"/>
      <Setter Property="Cursor"                     Value="Hand"/>
      <Setter Property="Padding"                    Value="14,11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="10" Margin="10,2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1E2A6E"/>
                <Setter Property="Foreground" Value="#87CEFA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavBtnOn" TargetType="Button" BasedOn="{StaticResource NavBtn}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="#1E3A8A" CornerRadius="10" Margin="10,2" Padding="{TemplateBinding Padding}">
              <Grid>
                <Rectangle Fill="#3AB8D8" Width="3" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" Margin="-14,8,0,8"/>
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="0,18,18,0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Tray -->
      <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="LaraStack">
        <tb:TaskbarIcon.ContextMenu>
          <ContextMenu FontFamily="Segoe UI" FontSize="12">
            <MenuItem Header="Open LaraStack"   Click="TrayOpen_Click"/>
            <Separator/>
            <MenuItem Header="▶  Start All"      Click="TrayStartAll_Click"/>
            <MenuItem Header="■  Stop All"       Click="TrayStopAll_Click"/>
            <Separator/>
            <MenuItem Header="🌐  Open Website"  Click="TrayOpenWeb_Click"/>
            <MenuItem Header="Exit"              Click="TrayExit_Click"/>
          </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
      </tb:TaskbarIcon>

      <!-- SIDEBAR -->
      <Border Grid.Column="0" CornerRadius="0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#060D3A" Offset="0"/>
            <GradientStop Color="#0A1FA8" Offset="0.7"/>
            <GradientStop Color="#1E3A8A" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Logo -->
          <Border Grid.Row="0" Padding="16,0" MouseLeftButtonDown="TitleBar_Down">
            <Image Source="pack://application:,,,/logo.png"
                   Height="52"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   UseLayoutRounding="True"/>
          </Border>

          <!-- Server status pills -->
          <Border Grid.Row="1" Margin="12,0,12,14" CornerRadius="12" Padding="14,12" BorderThickness="1">
            <Border.BorderBrush><SolidColorBrush Color="#1E3A8A" Opacity="0.8"/></Border.BorderBrush>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D1B5E" Offset="0"/>
                <GradientStop Color="#0A1748" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
              <TextBlock Text="SERVER STATUS" Foreground="#4A5C99" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="DotPhp" Width="8" Height="8" Fill="#333270" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="PHP" Foreground="#8A96C0" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
                <Border Grid.Column="2" x:Name="BadgePhp" CornerRadius="5" Padding="8,3" Background="#0D1B5E">
                  <TextBlock x:Name="LblPhp" Text="Stopped" Foreground="#4A5C99" FontFamily="Segoe UI" FontSize="10"/>
                </Border>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="DotMySql" Width="8" Height="8" Fill="#333270" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="MySQL" Foreground="#8A96C0" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
                <Border Grid.Column="2" x:Name="BadgeMySql" CornerRadius="5" Padding="8,3" Background="#0D1B5E">
                  <TextBlock x:Name="LblMySql" Text="Stopped" Foreground="#4A5C99" FontFamily="Segoe UI" FontSize="10"/>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Nav -->
          <StackPanel Grid.Row="2">
            <TextBlock Text="MAIN" Foreground="#3A4C80" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Margin="24,0,0,6"/>
            <Button x:Name="N0" Style="{StaticResource NavBtnOn}" Click="Nav_Click" Tag="Dashboard">
              <StackPanel Orientation="Horizontal"><TextBlock Text="🏠" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Dashboard" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="N1" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Services">
              <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Services" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="N2" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Installer">
              <StackPanel Orientation="Horizontal"><TextBlock Text="⬇" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Installer" VerticalAlignment="Center"/></StackPanel>
            </Button>

            <TextBlock Text="TOOLS" Foreground="#3A4C80" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Margin="24,14,0,6"/>
            <Button x:Name="N3" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Monitor">
              <StackPanel Orientation="Horizontal"><TextBlock Text="📊" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Monitor" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="N4" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Logs">
              <StackPanel Orientation="Horizontal"><TextBlock Text="📋" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Logs" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="N5" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Files">
              <StackPanel Orientation="Horizontal"><TextBlock Text="📁" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Files" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="N6" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Database">
              <StackPanel Orientation="Horizontal"><TextBlock Text="🗄" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Database" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="N7" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="PhpIni">
              <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="php.ini Editor" VerticalAlignment="Center"/></StackPanel>
            </Button>
          </StackPanel>

          <!-- Bottom quick actions -->
          <StackPanel Grid.Row="3" Margin="12,0,12,20">
            <Button Content="▶   START ALL" Style="{StaticResource BtnGreen}"
                    HorizontalAlignment="Stretch" Padding="0,12" Margin="0,0,0,8"
                    Click="StartAll_Click"/>
            <Button Content="■   STOP ALL" Style="{StaticResource BtnDanger}"
                    HorizontalAlignment="Stretch" Padding="0,12"
                    Click="StopAll_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- CONTENT -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="56"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                CornerRadius="0,18,0,0" MouseLeftButtonDown="TitleBar_Down">
          <Grid Margin="26,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="PageTitle" Text="Dashboard"
                         Foreground="{StaticResource BrushNavy}"
                         FontFamily="Segoe UI Semibold" FontSize="17"/>
              <Border CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center" Background="#EEF6FF">
                <TextBlock Text="LaraStack" Foreground="{StaticResource BrushBlue}"
                           FontFamily="Segoe UI Semibold" FontSize="9"/>
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Content="—" Width="30" Height="26" Style="{StaticResource BtnGhost}" Padding="0" Click="Minimize_Click" Margin="0,0,4,0"/>
              <Button Content="❐" Width="30" Height="26" Style="{StaticResource BtnGhost}" Padding="0" Click="Maximize_Click" Margin="0,0,4,0"/>
              <Button Content="✕" Width="30" Height="26" Style="{StaticResource BtnDanger}" Padding="0" FontSize="10" Click="Close_Click"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Page host -->
        <Border Grid.Row="1" Background="{StaticResource BrushBg}" CornerRadius="0,0,18,0">
          <Grid x:Name="Host"/>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
