<Application x:Class="LaraStack.User.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="BrushBg"       Color="#EFF3FB"/>
      <SolidColorBrush x:Key="BrushNavy"     Color="#0A1040"/>
      <SolidColorBrush x:Key="BrushBlue"     Color="#2255DD"/>
      <SolidColorBrush x:Key="BrushGreen"    Color="#00CB71"/>
      <SolidColorBrush x:Key="BrushPurple"   Color="#A020F0"/>
      <SolidColorBrush x:Key="BrushPink"     Color="#FF4F7B"/>
      <SolidColorBrush x:Key="BrushRed"      Color="#E53935"/>
      <SolidColorBrush x:Key="BrushText"     Color="#0A1040"/>
      <SolidColorBrush x:Key="BrushTextSub"  Color="#6B7280"/>
      <SolidColorBrush x:Key="BrushBorder"   Color="#D8E2F5"/>
      <SolidColorBrush x:Key="BrushTeal"     Color="#3AB8D8"/>

      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background"      Value="White"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="14"/>
        <Setter Property="Effect">
          <Setter.Value><DropShadowEffect Color="#2255DD" BlurRadius="20" ShadowDepth="2" Opacity="0.06"/></Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.3"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background">
          <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2255DD" Offset="0"/><GradientStop Color="#3D7BE8" Offset="1"/></LinearGradientBrush></Setter.Value>
        </Setter>
        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#2255DD" BlurRadius="14" ShadowDepth="0" Opacity="0.38"/></Setter.Value></Setter>
      </Style>

      <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background">
          <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00A85E" Offset="0"/><GradientStop Color="#00CB71" Offset="1"/></LinearGradientBrush></Setter.Value>
        </Setter>
        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00CB71" BlurRadius="14" ShadowDepth="0" Opacity="0.38"/></Setter.Value></Setter>
      </Style>

      <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background">
          <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#C62828" Offset="0"/><GradientStop Color="#E53935" Offset="1"/></LinearGradientBrush></Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="BtnPurple" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background">
          <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#7B11D4" Offset="0"/><GradientStop Color="#A020F0" Offset="1"/></LinearGradientBrush></Setter.Value>
        </Setter>
        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#A020F0" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/></Setter.Value></Setter>
      </Style>

      <Style x:Key="BtnGhost" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource BrushBlue}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#EEF1F8"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="TxtBox" TargetType="TextBox">
        <Setter Property="Background"      Value="White"/>
        <Setter Property="Foreground"      Value="{StaticResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,8"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
